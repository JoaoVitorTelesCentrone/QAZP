{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=Zvents.db"
  },
  "Jwt": {
    "Issuer": "MyAppIssuer",
    "Audience": "MyAppAudience",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "login": { "PermitLimit": 20, "WindowSeconds": 60 },
    "quote": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "AllowedHosts": "*"
}
